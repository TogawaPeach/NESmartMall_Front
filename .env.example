# Blank base URL uses the deployed frontend origin; configure only a confirmed backend URL.
VITE_API_BASE_URL=

# Defaults to /api/products. The dev server proxies /api to localhost:8080.
VITE_PRODUCTS_ENDPOINT=/api/products

# Separate catalogue pagination endpoint; backend implementation is pending.
VITE_PRODUCT_PAGE_ENDPOINT=/api/products/page

# Optional local order fixtures. Only installed by the development server.
# VITE_ORDER_MOCK=true
# VITE_ORDER_MOCK_SCENARIO=normal

# Checkout transactions require both explicit mocks; never enabled in production.
# VITE_CART_MOCK=true
# VITE_CART_MOCK_SCENARIO=normal
# Order scenarios also include create-unknown, create-malformed, pay-unknown, expired.

# Explicit development-only flash-sale preview. Off by default; no live API fallback.
# VITE_FLASH_SALE_DEMO=true
# Confirmed flash-sale list/detail GET contracts are in src/api/flashSaleContract.ts.
# The separate flash-sale checkout endpoint is still pending; purchases remain disabled.
